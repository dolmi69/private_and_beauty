# Скопируйте в .env. Пустой ключ включает локальный деморежим чата.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CLINIC_TIME_ZONE=Europe/Moscow
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Корневой сертификат из certs/ подключается автоматически. Здесь можно указать свой PEM.
GIGACHAT_CA_BUNDLE=
CHAT_FORCE_MOCK=false

# Токен только в локальном .env. Публичный URL должен использовать HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=
DJANGO_CSRF_TRUSTED_ORIGINS=
